SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-side only — used by src/integrations/supabase/client.server.ts.
# Never expose this to client code.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Used by src/integrations/supabase/cron-auth.ts to authenticate scheduled
# job requests. CRON_SECRET_PREVIOUS lets you rotate the secret without
# breaking in-flight scheduled requests signed with the old value.
CRON_SECRET="a-long-random-secret"
CRON_SECRET_PREVIOUS=""
